# ============================================================
# 网易云音乐 Telegram Bot - Render 部署版环境变量示例
# ------------------------------------------------------------
# 在 Render Dashboard -> Environment 添加以下变量。
# RENDER_EXTERNAL_URL 和 PORT 由 Render 自动注入，无需手动设置。
# BOT_TOKEN / ADMIN_ID / NETEASE_COOKIE 也可不填，改为存入 Upstash。
# ============================================================

# ---------- 必填：Upstash Redis（数据持久化） ----------
# 在 https://upstash.com 创建 Redis，复制 REST URL 和 Token
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ---------- 必填（或存入 Upstash）：Telegram Bot ----------
# 从 @BotFather 获取
BOT_TOKEN=123456:ABC-DEF...
# 管理员 Telegram 数字 ID（从 @userinfobot 获取）
ADMIN_ID=123456789

# ---------- 可选：网易云 MUSIC_U Cookie ----------
# 也可在 Bot 内用 /setcookie 设置（推荐，便于运行时更新）
NETEASE_COOKIE=

# ---------- 可选：音质 ----------
# standard / higher / exhigh / lossless / hires
MUSIC_QUALITY=standard

# ---------- 可选：访问 Telegram 的代理（Render 在境外，通常留空） ----------
PROXY_URL=

# ---------- 以下由 Render 自动注入，本地调试时才需要手动设置 ----------
# Render 自动提供，形如 https://your-app.onrender.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# Render 自动提供服务端口
# PORT=10000
